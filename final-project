def clean_location(value):

    text = str(value).strip()

    text = text.replace("Žnjana", "Žnjana")
    text = text.replace("i ", "i ")

    return text


def geocode_location(location):

    if location in manual:
        lat, lon = manual[location]
        return Point(lon, lat), "manual"

    text = clean_location(location)

    queries = [
        f"{text}, Split, Croatia"
    ]

    if "–" in text:
        queries.append(
            f"{text.split('–')[0].strip()}, Split, Croatia"
        )

    if ";" in text:
        queries.append(
            f"{text.split(';')[0].strip()}, Split, Croatia"
        )

    if "," in text:
        queries.append(
            f"{text.split(',')[0].strip()}, Split, Croatia"
        )

    for query in queries:

        try:

            result = ox.geocode(query)

            if result is None:
                continue

            lat, lon = result

            point = Point(lon, lat)

            if boundary.geometry.iloc[0].contains(point):

                return point, query

        except Exception:
            pass

    return None, None


