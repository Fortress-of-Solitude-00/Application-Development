    df["end_time"].astype(str),
    errors="coerce"
)

df["duration_hours"] = (
    df["end_time"] - df["start_time"]
).dt.total_seconds() / 3600

df.loc[
    df["duration_hours"] < 0,
    "duration_hours"
] += 24

df["cause"] = (
    df["cause"]
    .astype(str)
    .str.strip()
)

